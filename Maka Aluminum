 <!-- المساعد الافتراضي (شات بوت تفاعلي بالكتابة الحرة) -->
 <div class="chatbot-btn" onclick="toggleChat()">
 <i class="fa-solid fa-headset"></i>
 </div>

 <div class="chatbot-window" id="chatWindow">
 <div class="chat-header">
 <div style="display: flex; align-items: center; gap: 10px;">
 <img src="https://i.postimg.cc/NfHQ6xFc/Picsart-26-08-30-00-38-23-385.png" alt="لوجو ورشة مكة" class="chat-logo">
 <span>خدمة عملاء ورشة مكة</span>
 </div>
 <i class="fa-solid fa-times" onclick="toggleChat()"></i>
 </div>
 <div class="chat-body" id="chatBody">
 <div class="msg msg-bot">
 أهلاً بك في ورشة مكة! 🛠️ اسألني عن الأسعار، المواعيد، أو اكتب سؤالك وسأرد عليك فوراً!
 </div>
 <div class="chat-options" id="chatOptions">
 <button class="chat-opt-btn" onclick="botReplyPreset('gallery')">كيف أشاهد صور أعمالكم؟</button>
 <button class="chat-opt-btn" onclick="botReplyPreset('booking')">كيف أحجز معاينة مجانية؟</button>
 <button class="chat-opt-btn" onclick="botReplyPreset('offers')">ما هي عروض الموسم الحالية؟</button>
 </div>
 </div>
 <div class="chat-input-area">
 <input type="text" id="chatInput" placeholder="اكتب سؤالك هنا..." onkeypress="handleChatKey(event)">
 <button class="chat-send-btn" onclick="sendUserMessage()"><i class="fa-solid fa-paper-plane"></i></button>
 </div>
 </div>

 <script>
 // فتح وإغلاق Lightbox للصور
 function openLightbox(imgSrc, captionText) {
 const modal = document.getElementById('lightboxModal');
 const img = document.getElementById('lightboxImage');
 const caption = document.getElementById('lightboxCaption');
 modal.classList.add('active');
 img.src = imgSrc;
 caption.textContent = captionText;
 }
 function closeLightbox() {
 document.getElementById('lightboxModal').classList.remove('active');
 }

 // إرسال الطلب للواتساب
 function sendToWhatsApp(event) {
 event.preventDefault();
 const name = document.getElementById('name').value;
 const phone = document.getElementById('phone').value;
 const serviceType = document.getElementById('serviceType').value;
 const details = document.getElementById('details').value;
 const whatsappMessage = `*طلب معاينة جديد - ورشة مكة*%0a%0a*الاسم:* ${name}%0a*رقم الهاتف:* ${phone}%0a*نوع الخدمة:* ${serviceType}%0a*التفاصيل:* ${details}`;
 window.open(`https://wa.me/201146797153?text=${whatsappMessage}`, '_blank');
 }

 // تشغيل وإخفاء الشات بوت
 function toggleChat() {
 const chat = document.getElementById('chatWindow');
 chat.classList.toggle('active');
 }

 // ردود جاهزة للأزرار
 function botReplyPreset(type) {
 let userMsg = '';
 let botMsg = '';
 if(type === 'gallery') {
 userMsg = 'كيف أشاهد صور أعمالكم؟';
 botMsg = 'يمكنك مشاهدة صور أعمالنا في قسم "سابقة أعمالنا الحقيقية"، ويمكنك الضغط على أي صورة لتكبيرها ومشاهدتها بجودة عالية! 🖼️';
 } else if(type === 'booking') {
 userMsg = 'كيف أحجز معاينة مجانية؟';
 botMsg = 'بكل سهولة توجه إلى نموذج "اطلب استشارتك المجانية" أسفل الموقع، املأ بياناتك وسيتم تحويلك فوراً للواتساب لتأكيد الموعد. 📋';
 } else if(type === 'offers') {
 userMsg = 'ما هي عروض الموسم الحالية؟';
 botMsg = 'لدينا عروض وخصومات تصل إلى 20% على المطابخ والقطاعات الثقيلة PS مع تصميم 3D مجاني وإكسسوارات تركي هدية! ✨';
 }
 appendChatMessages(userMsg, botMsg);
 }

 // إرسال رسالة بالكتابة الحرة والرد الذكي
 function sendUserMessage() {
 const input = document.getElementById('chatInput');
 const text = input.value.trim();
 if(!text) return;

 let botResponse = "أهلاً بك! يسعدنا استفسارك. يمكنك التواصل معنا مباشرة عبر زر الواتساب في أعلى الموقع أو حجز معاينة مجانية وسيتواصل معك الفني المختص فوراً. 🛠️";
 
 const lowerText = text.toLowerCase();
 if(lowerText.includes('سعر') || lowerText.includes('تكلفة') || lowerText.includes('كام') || lowerText.includes('بكام')) {
 botResponse = "تختلف الأسعار حسب المقاسات وننوع القطاعات المطلوبة (مثل PS العادي أو الجامبو أو المطابخ الخشمنيوم). نحن نوفر معاينة ومقاسات مجانية لنعطيك السعر الدقيق تماماً! 📐";
 } else if(lowerText.includes('عنوان') || lowerText.includes('مكان') || lowerText.includes('فين') || lowerText.includes('مقر')) {
 botResponse = "مقرنا الرئيسي في الجيزة - فيصل - نزلة حي الهرم - شارع نايل سليمان. يسعدنا زيارتك أو تواصلك معنا! 📍";
 } else if(lowerText.includes('رقم') || lowerText.includes('تواصل') || lowerText.includes('اتصال')) {
 botResponse = "يمكنك التواصل معنا فوراً عبر رقم الواتساب: 01146797153 أو بالضغط على زر تواصل واتساب بالأعلى. 📞";
 }

 appendChatMessages(text, botResponse);
 input.value = '';
 }

 function handleChatKey(event) {
 if(event.key === 'Enter') {
 sendUserMessage();
 }
 }

 function appendChatMessages(userText, botText) {
 const chatBody = document.getElementById('chatBody');
 const options = document.getElementById('chatOptions');
 if(options) options.style.display = 'none';

 chatBody.innerHTML += `<div class="msg msg-user">${userText}</div>`;
 
 setTimeout(() => {
 chatBody.innerHTML += `<div class="msg msg-bot">${botText}</div>`;
 chatBody.scrollTop = chatBody.scrollHeight;
 }, 600);
 }

 // إضافة تقييم جديد ديناميكياً
 function addNewReview(event) {
 event.preventDefault();
 const name = document.getElementById('revName').value;
 const rate = document.getElementById('revRate').value;
 const text = document.getElementById('revText').value;
 const firstLetter = name.charAt(0);

 const grid = document.getElementById('testimonialsGrid');
 const newCard = document.createElement('div');
 newCard.className = 'testimonial-card';
 newCard.innerHTML = `
 <div class="client-info">
 <div class="client-avatar">${firstLetter}</div>
 <div><div class="client-name">${name}</div><div class="stars">${rate}</div></div>
 </div>
 <div class="testimonial-text">${text}</div>
 `;
 grid.prepend(newCard);
 alert('شكراً لك! تم إضافة تقييمك بنجاح وعرضه في القائمة ⭐');
 event.target.reset();
 }
 </script>
